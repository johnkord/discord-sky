# Copy to private.env next to compose.yaml and make it readable only by root (mode 600).
# Values here override public.env. Never commit the real file or bake it into an image.

Bot__Token=<discord-bot-token>
# Steward runs as a child process and reads this key; needed only with a WorldAutonomy guild binding.
Discord__BotToken=<discord-bot-token>
LLM__Providers__OpenAI__ApiKey=<openai-api-key>
# Needed only when LLM__ActiveProvider=xAI.
LLM__Providers__xAI__ApiKey=<xai-api-key>

# Optional exact-guild World Autonomy binding. The profile is profiles/<guild-id>.json on the host.
# WorldAutonomy__EnabledGuilds__<guild-id>__ProfilePath=/app/steward/profiles/<guild-id>.json

# Optional cold-open target.
# ColdOpen__Channels__0__GuildId=<guild-id>
# ColdOpen__Channels__0__ChannelId=<channel-id>
# ColdOpen__Channels__0__Guild=<display-label>
# ColdOpen__Channels__0__Channel=<display-label>
